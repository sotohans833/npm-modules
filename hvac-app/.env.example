# ---------------------------------------------------------------------------
# Database
#
# El motor se detecta solo a partir de esta URL (scripts/prepare-schema.mjs):
#   file:./dev.db            -> SQLite, para desarrollo local
#   postgresql://usuario:…   -> PostgreSQL, para producción (Vercel, Neon…)
#
# En Vercel, DATABASE_URL la crea la integración de Postgres. Si esa URL es
# agrupada (contiene "-pooler"), añada también DIRECT_URL con la versión sin
# agrupar: las conexiones agrupadas no pueden aplicar cambios de esquema.
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
DIRECT_URL=""

# ---------------------------------------------------------------------------
# Auth — 32+ random chars. Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
SESSION_SECRET="change-me-in-production-please-32-chars-min"

# ---------------------------------------------------------------------------
# Company profile (rendered across the site, no code changes needed)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_COMPANY_NAME="All Weather Heating & Cooling, Inc."
NEXT_PUBLIC_COMPANY_PHONE="(919) 967-9775"
NEXT_PUBLIC_COMPANY_EMERGENCY_PHONE="(919) 230-8572"
NEXT_PUBLIC_COMPANY_EMAIL="service@yourallweatherhvac.com"
NEXT_PUBLIC_COMPANY_ADDRESS="1301 S Briggs Ave #116, Durham, NC 27703"
NEXT_PUBLIC_COMPANY_SITE="https://www.yourallweatherhvac.com"

# ---------------------------------------------------------------------------
# Integrations. All of them run in MOCK mode while the keys are empty:
# every message is logged to the server console instead of being sent.
# Fill a key in and that single integration switches to live automatically.
# ---------------------------------------------------------------------------

# Transactional email (Resend). https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="All Weather HVAC <service@yourallweatherhvac.com>"

# SMS reminders (Twilio). https://twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Deposits / plan billing (Stripe). https://stripe.com
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Map embed + address autocomplete (Google Maps Platform)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Live Google reviews (Places API New). Without these the site falls back to
# the curated copy in src/content/reviews.ts.
# Enable "Places API (New)" in Google Cloud, then find the place ID with the
# Place ID Finder: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""

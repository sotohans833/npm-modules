{
  "name": "allweather-hvac-app",
  "version": "1.0.0",
  "private": true,
  "description": "Customer app for All Weather Heating & Cooling, Inc. (Durham, NC) - booking, quoting and customer portal",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:reset": "rimraf prisma/dev.db && prisma db push && npm run db:seed",
    "setup": "prisma generate && prisma db push && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "next": "15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "prisma": "6.19.3",
    "rimraf": "6.1.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}

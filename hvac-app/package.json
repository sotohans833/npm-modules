{
  "name": "allweather-hvac-app",
  "version": "1.0.0",
  "private": true,
  "description": "Customer app for All Weather Heating & Cooling, Inc. (Durham, NC) - booking, quoting and customer portal",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:reset": "rm -f prisma/dev.db && prisma db push && npm run db:seed",
    "setup": "prisma generate && prisma db push && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "next": "^15.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.7",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.4"
  }
}
